<?xml version="1.0"?>
<!-- Placeholder robot: a two-joint arm built from primitives so the template runs end to end.
     Replace the links and joints with your robot (or xacro:include upstream description files),
     keeping the ros2_control arguments and block at the bottom. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- MuJoCo rejects moving bodies without mass, so every moving link needs an <inertial>.
       Inertias here are solid boxes/cylinders; use CAD or measured values when dynamics matter. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
    </collision>
    <!-- No inertial: KDL rejects one on the root link, and without a free joint MuJoCo welds
         the root to the world anyway. A mobile base carries its mass on a fixed child link. -->
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.03" length="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.03" length="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="0.5"/>
      <inertia ixx="0.00178" ixy="0" ixz="0" iyy="0.00178" iyz="0" izz="0.000225"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="0.3"/>
      <inertia ixx="0.00160" ixy="0" ixz="0" iyy="0.00160" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <!-- Velocity limits must be non-zero: joint_trajectory_controller and MoveIt read them. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2.0"/>
  </joint>

  <!-- ros2_control hardware: none (visualization only) or mujoco. Defaults keep the plain
       URDF free of hardware, which is also what the MJCF generator expands. -->
  <xacro:arg name="ros2_control" default="none"/>
  <!-- MJCF scene loaded by the MuJoCo hardware plugin. -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="headless" default="false"/>

  <!-- initial is the joint position MuJoCo starts at. Keep it strictly inside the joint
       limits: exactly on a limit, numerical drift trips the joint limiter. -->
  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${'$(arg ros2_control)' == 'mujoco'}">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg headless)</param>
      </hardware>
      <!-- Each commanded joint needs a MuJoCo actuator of the same name in mujoco_inputs.xml. -->
      <xacro:position_joint name="joint1"/>
      <xacro:position_joint name="joint2"/>
    </ros2_control>
  </xacro:if>

</robot>
